metax = include_lib("/lib/metaxploit.so")
if not metax then exit("Error: Missing metaxploit library")

sh = get_shell
computer = sh.host_computer

// ---------------- Helper: check root ----------------

Check_Root = function(obj)
	comp = (obj)
	if typeof(comp) == "shell" then comp = obj.host_computer
	if typeof(comp) != "computer" then return false
	file = comp.File("/")
	if not file then return false
	filelist = file.get_folders + file.get_files
	newlist = []
	while filelist.len > 0
		f = filelist.pull
		if f.is_folder then filelist = filelist + f.get_folders + f.get_files
		newlist.push f
	end while
	for item in newlist
		if not item.has_permission("w") then return false
	end for
	return true
end function

// ---------------- Proxy hop functions ----------------

random_ip = function
	o1 = floor(rnd * 223) + 1
	o2 = floor(rnd * 255)
	o3 = floor(rnd * 255)
	o4 = floor(rnd * 254) + 1
	return o1 + "." + o2 + "." + o3 + "." + o4
end function

get_open_ports = function(ip)
	isLanIp = is_lan_ip(ip)
	if isLanIp then
		router = get_router
	else
		router = get_router(ip)
	end if
	if router == null then return null

	ports = null
	if not isLanIp then
		ports = router.used_ports
	else
		ports = router.device_ports(ip)
	end if
	if ports == null then return null
	if typeof(ports) == "string" then return null
	return ports
end function

// ---------------- Core exploit chain (based on overflow reference) ----------------

exploit_service = function(ip, port)
	netSession = metax.net_use(ip, port)
	if not netSession then return null

	metalib = netSession.dump_lib
	if not metalib then return null

	mems = metax.scan(metalib)
	if mems == null then return null

	for mem in mems
		vulnsRaw = metax.scan_address(metalib, mem)
		if vulnsRaw == null then continue
		vulns = vulnsRaw.split("Unsafe check: ")
		for vuln in vulns
			if vuln == vulns[0] then continue
			vulnName = vuln[vuln.indexOf("<b>") + 3 : vuln.indexOf("</b>")]
			object = metalib.overflow(mem, vulnName)
			if object == null then continue

			if typeof(object) == "shell" then
				if Check_Root(object) then
					print "  [ROOT] gained root shell on " + ip + ":" + port + " via " + vulnName
					return object
				else
					print "  [ACCESS] gained user shell (no root) on " + ip + ":" + port + " via " + vulnName
					return object
				end if
			else if typeof(object) == "computer" then
				print "  [ACCESS] gained computer object on " + ip + ":" + port + " via " + vulnName
				return object
			end if
		end for
	end for
	return null
end function

try_gain_access = function(ip)
	ports = get_open_ports(ip)
	if ports == null or ports.len == 0 then return null
	for port in ports
		if port.is_closed then continue
		result = exploit_service(ip, port.port_number)
		if result != null then return result
	end for
	return null
end function

// ---------------- Proxy hop (connect_ip removed - unconfirmed method) ----------------

proxy_hop = function(maxAttempts)
	attempts = 0
	while attempts < maxAttempts
		ip = random_ip
		print "Attempting proxy hop through " + ip + "..."
		obj = try_gain_access(ip)
		if obj != null then
			print "Gained access to " + ip + " (routing/hop step skipped - method unconfirmed)"
			return ip
		end if
		attempts += 1
	end while
	print "Could not establish a proxy hop after " + maxAttempts + " attempts. Continuing without one."
	return null
end function

// ---------------- Scanner + auto-exploit ----------------

scan_target = function(ip)
	if not is_valid_ip(ip) then return 
	ports = get_open_ports(ip)
	if ports == null or ports.len == 0 then return 

	isLanIp = is_lan_ip(ip)
	router = null
	if isLanIp then
		router = get_router
	else
		router = get_router(ip)
	end if

	print "Scanning " + ip + "..."
	for port in ports
		portStatus = "open"
		if port.is_closed and not isLanIp then portStatus = "closed"
		serviceInfo = router.port_info(port)
		print ip + ":" + port.port_number + " -> " + portStatus + " " + serviceInfo

		if portStatus == "closed" then continue

		gained = exploit_service(ip, port.port_number)
		if gained == null then
			print "  no working exploit for this service"
		end if
	end for
end function

expand_range = function(baseIp, startHost, endHost)
	parts = baseIp.split(".")
	prefix = parts[0] + "." + parts[1] + "." + parts[2] + "."
	ips = []
	for i in range(startHost, endHost)
		ips.push prefix + i
	end for
	return ips
end function

// ---------------- Main flow (fully automatic) ----------------

print "=== Auto-Hack Tool (auto mode) ==="

proxy_hop 10

localIp = computer.local_ip
if localIp == null then exit("Error: Could not determine local IP")

ipList = expand_range(localIp, 1, 254)
for ip in ipList
	scan_target ip
end for

print "Done."