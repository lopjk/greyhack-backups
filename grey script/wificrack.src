view = function(bucket)
	for each in bucket
		print "bssid: " + each.bssid + " power " + each.pwr + " essid: " + each.essid
	end for
end function
path = "/home/" + active_user + "/Desktop"
cryptools = include_lib("/lib/crypto.so")
if not cryptools then exit("Error: Missing crypto library")
output = cryptools.airmon("start", "wlan0")
if typeof(output) == "string" then exit("airmon: " + output)
sh = get_shell
computer = sh.host_computer
devices = computer.network_devices
if devices == null then exit("iwlist: Network device not found")
networks = computer.wifi_networks("wlan0")
if networks == null then exit(command_info("iwlist_usage"))
if typeof(networks) == "string" then exit(networks)
bucket = []
for each in networks
	bits = each.split(" ")
	bssid = bits[0]
	pwr = bits[1]
	essid = bits[2]

	bucket.push {
		"bssid": bssid,
		"essid": essid,
		"pwr": pwr,}
end for
if params.len == 1 and params[0] == "-v" then
	view bucket
	exit
end if
// First try — Net._wifiRequiredAcks: ceil(300000 / (power + 15)) + 1 Retry — Net._wifiRetryAcks: max of ceil(prevAcks * 1.5) and ceil(300000 / power) + 1
// 300000 / (power + 15)) + 1
// 59:05:76:16:29:0F--Liatergent_PTV5Z--Jungra
// 59:05:76:16:29:0F--Liatergent_PTV5Z--arlosep
// 59:05:76:16:29:0F--Liatergent_PTV5Z--fluffi
tree = function(SomePayload, Somebssid) // temp ver
	if not SomePayload then return false
	for each in SomePayload.split(char(10))
		if not each then continue
		data = each.split("--")
		bssid = data[0]
		pwr = data[1]
		essid = data[2]
		if Somebssid != bssid then continue
		return true
	end for
	return false
end function
// ceil() helper wrapper for the acks math
ceilDiv = function(numerator, denominator)
	return ceil(numerator / denominator)
end function
path = "/home/" + active_user + "/Desktop"
hostComputer = get_shell.host_computer
createResult = hostComputer.create_folder(path, "wifi_folder")
if typeof(createResult) == "string" then
	print ("The file already exists: " + createResult)
else
	print "Folder got created at given path " + path
end if
computer.touch path + "/wifi_folder", "passwords"
passFile = computer.File(path + "/wifi_folder/passwords")
// 300000 / (power + 15)) + 1
// pwr_math = 300000 / (each.pwr + 15)
// print (pwr_math)
MAX_ATTEMPTS = 6   // safety cap so the retry loop can't run forever
for each in bucket
	pwrValue = val(each.pwr.replace("%", ""))
	if pwrValue < 30 then continue
	tempPayload = passFile.get_content
	if tree(tempPayload, each.bssid) then continue
	// --- first-try ACK count ---
	acksNeeded = ceilDiv(300000, pwrValue + 15) + 1
	key = null
	attempt = 1
	while attempt <= MAX_ATTEMPTS
		print "Attempt " + attempt + " for " + each.essid + " — requesting " + acksNeeded + " acks"
		result = cryptools.aireplay(each.bssid, each.essid, acksNeeded)
		pathFile = "/home/" + active_user + "/file.cap"
		file = get_shell.host_computer.File(pathFile)
		if file == null then exit("aircrack: file not found: " + pathFile)
		if not file.is_binary then exit("aircrack: Can't process file. Not valid filecap.")
		if not file.has_permission("r") then exit("aircrack: permission denied")
		key = cryptools.aircrack(pathFile)
		if key then break
		// --- retry ACK count ---
		retryAcks = ceilDiv(acksNeeded * 1.5, 1)
		minRetryAcks = ceilDiv(300000, pwrValue) + 1
		if minRetryAcks > retryAcks then retryAcks = minRetryAcks
		acksNeeded = retryAcks
		attempt = attempt + 1
	end while
	if key then
		existing = passFile.get_content
		if not existing then existing = ""
		wifipasswords = passFile.set_content(existing + each.bssid + "--" + each.essid + "--" + key + char(10))
		print "KEY FOUND! [<color=#FF0000>" + key + "</color>]"
		connectResult = computer.connect_wifi(each.essid, key, "wlan0")
		if typeof(connectResult) == "string" then
			print "connect_wifi error: " + connectResult
		else
			print "Connected to " + each.essid + " successfully!"
		end if
	else
		print "aircrack: Unable to get the key for " + each.essid + " after " + MAX_ATTEMPTS + " attempts"
	end if
end for
// iwlist(to list wifis)
// airmon(monitor wifi mode)
// aireplay(to start buildin acks on the network)
// aircrack(gets the password from the saved aireplay file)